# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI Configuration & Model Cascade
AI_PRIMARY_MODEL="gemini-3.8-flash"
AI_FALLBACK_MODEL="gemini-3.1-flash-lite"
AI_SECONDARY_FALLBACK_MODEL="gemini-flash-latest"

# Supabase PostgreSQL & Storage (Optional: For external Supabase deployment)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Sheets User Registrations Integration (Choose Option A or Option B)
# Option A: Google Cloud Service Account
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id"
GOOGLE_SHEETS_WORKSHEET_NAME="User Registrations"
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS='{"client_email":"...","private_key":"..."}'

# Option B: Google Apps Script Webhook Endpoint
GOOGLE_APPS_SCRIPT_ENDPOINT="https://script.google.com/macros/s/.../exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="optional_secret_for_apps_script"
